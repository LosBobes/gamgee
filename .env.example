POSTGRES_USER=gamgee
POSTGRES_PASSWORD=gamgee
POSTGRES_DB=gamgee

# JWT signing secret (set a long random string in production)
JWT_SECRET=change-me-in-production-please

# ── Outbound email (SendGrid) ────────────────────────────────────────────────
# Leaving SENDGRID_API_KEY empty disables sending: messages are logged to the
# backend stdout instead, which is fine for local dev. See
# docs/sendgrid-setup.md for the full production walkthrough.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Gamgee

# Public URL of the frontend, used to build links inside emails.
# In docker-compose dev this is the Vite server; in production set it to the
# domain users actually hit, e.g. https://gamgee.example.com
APP_BASE_URL=http://localhost:5173
