POSTGRES_USER=gamgee
POSTGRES_PASSWORD=gamgee
POSTGRES_DB=gamgee

# JWT signing secret (set a long random string in production)
JWT_SECRET=change-me-in-production-please

# Server-side secret combined with passwords before bcrypt hashing (pepper).
# Generate with: openssl rand -hex 32
# IMPORTANT: rotating or losing this value invalidates all existing passwords.
PASSWORD_PEPPER=

# ── Outbound email (SendGrid) ────────────────────────────────────────────────
# Leaving SENDGRID_API_KEY empty disables sending: messages are logged to the
# backend stdout instead, which is fine for local dev. See
# docs/sendgrid-setup.md for the full production walkthrough.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Gamgee

# Public URL of the frontend, used to build links inside emails.
# In docker-compose dev this is the Vite server; in production set it to the
# domain users actually hit, e.g. https://gamgee.example.com
APP_BASE_URL=http://localhost:5173

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Leaving these empty disables browser push notifications; the in-app bell
# keeps working over SSE. Generate a fresh keypair with:
#   docker compose exec backend python -m app.gen_vapid
# (or from a local backend venv: `python -m app.gen_vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Extra CORS origins (comma-separated) — useful when the frontend is served
# from a domain other than APP_BASE_URL.
CORS_EXTRA_ORIGINS=

# ── Rate limiting ────────────────────────────────────────────────────────────
# In-process IP rate limit on sensitive endpoints (login, forgot-password,
# motivate, /coach-ai/ask). Set to false to disable in dev.
RATE_LIMIT_ENABLED=true

# ── AI coach (Anthropic Claude) ──────────────────────────────────────────────
# Set ANTHROPIC_API_KEY to enable the /api/coach-ai endpoints. Without it the
# frontend AI panel just hides itself.
# Requires the `anthropic` SDK to be installed in the backend image.
ANTHROPIC_API_KEY=
# Model identifier (default: claude-sonnet-4-6). Pick a smaller model to
# reduce cost.
CLAUDE_COACH_MODEL=claude-sonnet-4-6
# Per-user daily cap on coach-ai questions (default 30, counter is in-process).
COACH_AI_MAX_PER_DAY=30

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN — leave empty to disable. Also requires `pip install sentry-sdk`.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# Prometheus /metrics endpoint. Requires
# `pip install prometheus-fastapi-instrumentator`.
PROMETHEUS_ENABLED=false
