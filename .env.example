POSTGRES_USER=gamgee
POSTGRES_PASSWORD=gamgee
POSTGRES_DB=gamgee

# Secret used to sign JWT auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please

# Server-side secret combined with passwords before bcrypt hashing (pepper).
# Generate with: openssl rand -hex 32
# IMPORTANT: rotating or losing this value invalidates all existing passwords.
PASSWORD_PEPPER=
